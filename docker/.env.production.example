# Copia este archivo a `charles/.env.production` en el servidor y completa cada valor.
# Nunca subas el archivo completado al repositorio. Guía paso a paso: docs/DESPLIEGUE.md

# --- Dominios y certificados (Caddy los obtiene solo con Let's Encrypt) ---
API_DOMAIN=api.ejemplo.pe
PANEL_DOMAIN=panel.ejemplo.pe
ACME_EMAIL=

# --- Base de datos y Redis (red privada de Docker) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
PRIVATE_NETWORK=true
BACKUP_KEEP_DAYS=14

# --- API ---
CORS_ORIGINS=https://panel.ejemplo.pe
COOKIE_DOMAIN=ejemplo.pe
PUBLIC_API_URL=https://api.ejemplo.pe
LOG_LEVEL=info

# Claves de 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=1:
FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=1
BLIND_INDEX_KEY=
# openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | base64 -w0
JWT_PRIVATE_KEY=

# --- Correo (Resend, con dominio verificado) ---
MAILER_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=Charles <no-responder@ejemplo.pe>

# --- Notificaciones push (Expo) ---
PUSH_DRIVER=expo
EXPO_ACCESS_TOKEN=

# --- Fotos (almacenamiento S3 compatible: Cloudflare R2, AWS S3...) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# --- Pagos: izipay o mercadopago (credenciales de producción) ---
PAYMENTS_GATEWAY=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
IZIPAY_MODE=PRODUCTION
IZIPAY_MERCHANT_CODE=
IZIPAY_API_KEY=
IZIPAY_HASH_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_RUC=
