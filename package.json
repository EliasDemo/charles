{
  "name": "charles",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "verify": "node scripts/verify.mjs",
    "mobile:openapi": "pnpm --filter api openapi:export && node -e \"require('node:fs').copyFileSync('apps/api/openapi.json', 'docs/mobile/openapi.json')\"",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "3.24.5",
      "deepmerge-ts": "8.0.2",
      "handlebars": "4.7.10"
    }
  }
}
