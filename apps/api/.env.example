# Copia este archivo a .env (nunca subas .env al repositorio).
# Los valores coinciden con docker-compose.yml y solo sirven para desarrollo local.
NODE_ENV=development
PORT=3000
# En producción: incluir sslmode=verify-full (obligatorio).
DATABASE_URL=postgresql://charles:charles_local_only@127.0.0.1:5432/charles?schema=public
# Conexiones máximas del pool por instancia (2–100). Recomendado: 10.
DATABASE_POOL_MAX=10
# En producción: rediss:// (TLS obligatorio).
REDIS_URL=redis://127.0.0.1:6379/0
# Orígenes exactos separados por coma. Prohibido "*". En producción solo https.
CORS_ORIGINS=http://localhost:3001
# false | número de saltos | lista de IPs/CIDR/loopback/linklocal/uniquelocal. Prohibido "true".
TRUST_PROXY=loopback
# Prohibido en producción.
SWAGGER_ENABLED=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
BODY_LIMIT=100kb
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Cifrado de campos (AES-256-GCM) e índice ciego (HMAC-SHA256). Claves de 32 bytes en base64.
# Nunca reutilices estas claves entre entornos ni las subas al repositorio. Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Formato: <versión>:<clave>[,<versión>:<clave>...] (varias versiones permiten rotar).
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=1
# Debe ser distinta de las claves de cifrado.
BLIND_INDEX_KEY=
# Solo para `prisma db seed` (usuarios de prueba). Mínimo 12 caracteres. Nunca en producción.
SEED_USER_PASSWORD=
# Token de acceso ES256: clave privada EC P-256 en PEM PKCS#8, codificada en base64 (una línea).
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | base64 -w0
JWT_PRIVATE_KEY=
JWT_ISSUER=charles-api
JWT_AUDIENCE=charles-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Gracia (s) en que un token de renovación recién rotado devuelve el mismo sucesor. 0 la desactiva.
REFRESH_TOKEN_GRACE_SECONDS=10
# Solo "fake" por ahora (guarda los correos en Redis; prohibido en producción). Proveedor real: Fase 10.
MAILER_DRIVER=fake
# Fase 10: push simulado (fake) o Expo Push Service (expo). En producción, expo.
PUSH_DRIVER=fake
# EXPO_ACCESS_TOKEN=  (solo si el proyecto de Expo exige token; nunca en el repositorio)

# Fase 14: almacenamiento de imágenes (S3). Local: SeaweedFS de docker-compose (credenciales
# solo locales, docker/seaweedfs/s3.json). Producción: Cloudflare R2, ver docs/pendientes-produccion.md.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=charles-dev
S3_ACCESS_KEY_ID=charles_local_only
S3_SECRET_ACCESS_KEY=charles_local_only_secret
S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_BASE_URL=  (vacío en local: la API sirve las imágenes en /api/v1/media/...)

# ───── Fase 8B: pagos ─────
# fake: pasarela simulada (desarrollo; se paga con `pnpm --filter api dev:pay`). mercadopago: Checkout Pro.
# izipay: botón de pagos de Izipay. Exige todas las IZIPAY_* y PUBLIC_API_URL.
PAYMENTS_GATEWAY=fake
# URL pública de esta API (sin /api/v1): página de pago, regreso del formulario y notificación (IPN).
# PUBLIC_API_URL=https://xxxx.trycloudflare.com
# IZIPAY_MODE=TEST
# Credenciales del panel de Izipay (Desarrolladores → Claves). Nunca en el repositorio.
# IZIPAY_MERCHANT_CODE=
# IZIPAY_API_KEY=
# IZIPAY_HASH_KEY=
# IZIPAY_PUBLIC_KEY=
# IZIPAY_RUC=
# Mercado Pago (PAYMENTS_GATEWAY=mercadopago). Credenciales solo aquí, nunca en el repositorio.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# ───── Web de administración (charlesweb): cookies de sesión ─────
# COOKIE_SECURE=true          # obligatorio en producción (localhost lo admite por http en el navegador)
# COOKIE_DOMAIN=.charles.pe   # producción: dominio común de la web y la API
