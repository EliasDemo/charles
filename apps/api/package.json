{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.ts --runInBand",
    "openapi:export": "ts-node --transpile-only -P tsconfig.build.json src/scripts/export-openapi.ts",
    "dev:pay": "ts-node --transpile-only -P tsconfig.build.json src/scripts/dev-pay.ts",
    "dev:mail": "ts-node --transpile-only -P tsconfig.build.json src/scripts/dev-mail.ts",
    "dev:booking": "ts-node --transpile-only -P tsconfig.build.json src/scripts/dev-booking.ts",
    "admin:grant": "ts-node --transpile-only -P tsconfig.build.json src/scripts/admin-grant.ts",
    "migrate:ruc": "ts-node --transpile-only -P tsconfig.build.json src/scripts/migrate-ruc.ts",
    "prisma": "prisma",
    "seed:reference": "tsx prisma/seed-reference.ts",
    "seed:plans": "tsx prisma/seed-plans.ts",
    "postinstall": "prisma generate",
    "test:cov:availability": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage.config.ts --runInBand",
    "test:cov:search": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-search.config.ts --runInBand",
    "test:load:race": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-load.config.ts --runInBand",
    "test:cov:bookings": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-bookings.config.ts --runInBand",
    "test:cov:reviews": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-reviews.config.ts --runInBand",
    "test:cov:admin": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-admin.config.ts --runInBand",
    "test:cov:notifications": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-notifications.config.ts --runInBand",
    "test:cov:images": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e-coverage-images.config.ts --runInBand",
    "dev:demo-photos": "ts-node --transpile-only -P tsconfig.build.json src/scripts/demo-photos.ts",
    "dev:demo-juliaca": "ts-node --transpile-only -P tsconfig.build.json src/scripts/demo-juliaca.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "luxon": "3.7.2",
    "nestjs-pino": "5.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/ffprobe-static": "2.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "^17.4.1",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
