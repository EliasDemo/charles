/// Venta en el local (con o sin reserva previa).
model LocalSale {
  id             String            @id @default(uuid(7)) @db.Uuid
  barbershopId   String            @map("barbershop_id") @db.Uuid
  shopClientId   String?           @map("shop_client_id") @db.Uuid
  barberId       String?           @map("barber_id") @db.Uuid
  cashSessionId  String?           @map("cash_session_id") @db.Uuid
  membershipId   String?           @map("membership_id") @db.Uuid
  subtotalAmount Int               @map("subtotal_amount")
  discountAmount Int               @default(0) @map("discount_amount")
  totalAmount    Int               @map("total_amount")
  currency       String            @db.Char(3)
  paymentMethod  SalePaymentMethod @map("payment_method")
  status         SaleStatus        @default(COMPLETED)
  voidReason     String?           @map("void_reason")
  voidedAt       DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidedById     String?           @map("voided_by") @db.Uuid
  createdById    String            @map("created_by") @db.Uuid
  idempotencyKey String            @map("idempotency_key")
  soldAt         DateTime          @map("sold_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop  Barbershop           @relation(fields: [barbershopId], references: [id])
  shopClient  ShopClient?          @relation(fields: [shopClientId], references: [id])
  barber      Barber?              @relation(fields: [barberId], references: [id])
  cashSession CashSession?         @relation(fields: [cashSessionId], references: [id])
  membership  Membership?          @relation(fields: [membershipId], references: [id])
  lines       LocalSaleLine[]
  invoice     Invoice?
  creditUse   MembershipCreditUse?

  @@unique([barbershopId, idempotencyKey])
  @@index([barbershopId, soldAt])
  @@index([shopClientId])
  @@index([barberId])
  @@index([cashSessionId])
  @@index([membershipId])
  @@map("local_sales")
}

model LocalSaleLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  description String
  quantity    Int      @db.SmallInt
  unitAmount  Int      @map("unit_amount")
  totalAmount Int      @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sale    LocalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service?  @relation(fields: [serviceId], references: [id])

  @@index([saleId])
  @@index([serviceId])
  @@map("local_sale_lines")
}

enum InvoiceStatus {
  PENDING
  ISSUED
  REJECTED
  FAILED
  VOIDED
}

/// Emisión de boletas de una barbería (su propia cuenta en el proveedor autorizado).
model InvoicingConfig {
  id           String   @id @default(uuid(7)) @db.Uuid
  barbershopId String   @unique @map("barbershop_id") @db.Uuid
  provider     String
  enabled      Boolean  @default(false)
  series       String   @db.VarChar(4)
  nextNumber   Int      @default(1) @map("next_number")
  /// Credenciales del proveedor (cifradas): ruta y token de Nubefact.
  apiUrlEnc    String?  @map("api_url_enc")
  tokenEnc     String?  @map("token_enc")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  @@map("invoicing_configs")
}

/// Boleta electrónica de una venta en el local.
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  barbershopId    String        @map("barbershop_id") @db.Uuid
  saleId          String        @unique @map("sale_id") @db.Uuid
  series          String        @db.VarChar(4)
  number          Int
  status          InvoiceStatus @default(PENDING)
  customerName    String?       @map("customer_name")
  customerDocType String?       @map("customer_doc_type")
  customerDocEnc  String?       @map("customer_doc_enc")
  totalAmount     Int           @map("total_amount")
  taxAmount       Int           @map("tax_amount")
  currency        String        @db.Char(3)
  provider        String
  providerData    Json          @default("{}") @map("provider_data")
  pdfUrl          String?       @map("pdf_url")
  attempts        Int           @default(0)
  lastError       String?       @map("last_error")
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  sale       LocalSale  @relation(fields: [saleId], references: [id])

  @@unique([barbershopId, series, number])
  @@index([status, updatedAt])
  @@map("invoices")
}

// ═════════════════════ Fase 16: membresías ═════════════════════

enum MembershipStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Membresía que ofrece una barbería: créditos por mes para los servicios elegidos.
model MembershipPlan {
  id               String    @id @default(uuid(7)) @db.Uuid
  barbershopId     String    @map("barbershop_id") @db.Uuid
  name             String
  description      String?
  priceAmount      Int       @map("price_amount")
  currency         String    @db.Char(3)
  creditsPerPeriod Int       @map("credits_per_period") @db.SmallInt
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  barbershop  Barbershop              @relation(fields: [barbershopId], references: [id])
  services    MembershipPlanService[]
  memberships Membership[]

  @@index([barbershopId])
  @@map("membership_plans")
}

model MembershipPlanService {
  id               String   @id @default(uuid(7)) @db.Uuid
  membershipPlanId String   @map("membership_plan_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id])

  @@unique([membershipPlanId, serviceId])
  @@index([serviceId])
  @@map("membership_plan_services")
}

/// Membresía de un cliente (cobro mensual con la pasarela; créditos por periodo pagado).
model Membership {
  id                     String           @id @default(uuid(7)) @db.Uuid
  membershipPlanId       String           @map("membership_plan_id") @db.Uuid
  barbershopId           String           @map("barbershop_id") @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  status                 MembershipStatus @default(PENDING)
  priceAmount            Int              @map("price_amount")
  currency               String           @db.Char(3)
  creditsPerPeriod       Int              @map("credits_per_period") @db.SmallInt
  provider               String
  providerSubscriptionId String?          @map("provider_subscription_id")
  checkoutUrl            String?          @map("checkout_url")
  currentPeriodStart     DateTime?        @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?        @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean          @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?        @map("canceled_at") @db.Timestamptz(3)
  endedAt                DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  membershipPlan MembershipPlan        @relation(fields: [membershipPlanId], references: [id])
  barbershop     Barbershop            @relation(fields: [barbershopId], references: [id])
  user           User                  @relation("MembershipUser", fields: [userId], references: [id])
  lots           MembershipCreditLot[]
  charges        BillingCharge[]
  sales          LocalSale[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([barbershopId, status])
  @@index([membershipPlanId])
  @@map("memberships")
}

/// Créditos otorgados por un periodo pagado; vencen al final del periodo siguiente.
model MembershipCreditLot {
  id           String   @id @default(uuid(7)) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  chargeId     String?  @unique @map("charge_id") @db.Uuid
  granted      Int      @db.SmallInt
  remaining    Int      @db.SmallInt
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership Membership            @relation(fields: [membershipId], references: [id])
  charge     BillingCharge?        @relation(fields: [chargeId], references: [id])
  uses       MembershipCreditUse[]

  @@index([membershipId, expiresAt])
  @@map("membership_credit_lots")
}

/// Uso de un crédito: en una reserva o en una venta del local. Se devuelve si se anula.
model MembershipCreditUse {
  id         String    @id @default(uuid(7)) @db.Uuid
  lotId      String    @map("lot_id") @db.Uuid
  bookingId  String?   @unique @map("booking_id") @db.Uuid
  saleId     String?   @unique @map("sale_id") @db.Uuid
  restoredAt DateTime? @map("restored_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lot     MembershipCreditLot @relation(fields: [lotId], references: [id])
  booking Booking?            @relation(fields: [bookingId], references: [id])
  sale    LocalSale?          @relation(fields: [saleId], references: [id])

  @@index([lotId])
  @@map("membership_credit_uses")
}

// ═════════════════════ Forma de cara, etapa 2 ═════════════════════

enum StyleInteractionKind {
  VIEW
  SAVE
  BOOK
}

/// Interacción de una persona con una foto o un corte (para recomendar mejor).
model StyleInteraction {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  imageId   String?              @map("image_id") @db.Uuid
  styleId   String?              @map("style_id") @db.Uuid
  kind      StyleInteractionKind
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User          @relation("StyleInteractionUser", fields: [userId], references: [id])
  image Image?        @relation(fields: [imageId], references: [id])
  style ServiceStyle? @relation(fields: [styleId], references: [id])

  @@index([userId, createdAt])
  @@index([imageId])
  @@index([styleId, kind])
  @@map("style_interactions")
}

// ═════════════════════ Ubicación, bolsa de trabajo y saldos ═════════════════════

/// Distritos del Perú (UBIGEO del INEI): datos de referencia. Fuente: ubigeo-peru-aumentado de
/// J. M. Castagnetto (licencia MIT), a partir de los códigos de INEI y RENIEC.
model PeruDistrict {
  id         String   @id @default(uuid(7)) @db.Uuid
  ubigeo     String   @unique @db.Char(6)
  department String
  province   String
  district   String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershops    Barbershop[]
  barberProfiles BarberProfile[]
  jobPostings    JobPosting[]

  @@index([department, province])
  @@index([province])
  @@map("peru_districts")
}

enum JobPayType {
  FIXED
  COMMISSION
  MIXED
  PER_SERVICE
}

enum JobPayPeriod {
  DAY
  WEEK
  BIWEEKLY
  MONTH
  PER_SERVICE
}

enum JobSelectionProcess {
  INTERVIEW
  TRIAL
  DIRECT
}

enum JobOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// Oferta directa de una barbería a un barbero (él la acepta o la rechaza).
model JobOffer {
  id              String         @id @default(uuid(7)) @db.Uuid
  barbershopId    String         @map("barbershop_id") @db.Uuid
  barberProfileId String         @map("barber_profile_id") @db.Uuid
  title           String
  message         String?
  employmentType  EmploymentType @map("employment_type")
  payMin          Int?           @map("pay_min")
  payMax          Int?           @map("pay_max")
  payType         JobPayType?    @map("pay_type")
  payPeriod       JobPayPeriod?  @map("pay_period")
  schedule        String?
  status          JobOfferStatus @default(PENDING)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  respondedAt     DateTime?      @map("responded_at") @db.Timestamptz(3)
  responseNote    String?        @map("response_note")
  createdById     String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop    Barbershop    @relation(fields: [barbershopId], references: [id])
  barberProfile BarberProfile @relation(fields: [barberProfileId], references: [id])

  @@index([barbershopId, status])
  @@index([barberProfileId, status])
  @@map("job_offers")
}

enum SellerAccountStatus {
  PENDING
  CONNECTED
  REVOKED
}

/// Cuenta de Mercado Pago de la barbería (pago dividido): el cobro va directo a ella y Charles
/// recibe su comisión. Tokens cifrados.
model SellerAccount {
  id                  String              @id @default(uuid(7)) @db.Uuid
  barbershopId        String              @unique @map("barbershop_id") @db.Uuid
  provider            String
  status              SellerAccountStatus @default(PENDING)
  providerUserId      String?             @map("provider_user_id")
  publicKey           String?             @map("public_key")
  accessTokenEnc      String?             @map("access_token_enc")
  refreshTokenEnc     String?             @map("refresh_token_enc")
  tokenExpiresAt      DateTime?           @map("token_expires_at") @db.Timestamptz(3)
  oauthState          String?             @unique @map("oauth_state")
  oauthStateExpiresAt DateTime?           @map("oauth_state_expires_at") @db.Timestamptz(3)
  connectedAt         DateTime?           @map("connected_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  @@index([provider, providerUserId])
  @@map("seller_accounts")
}

enum PaymentPayee {
  /// Cobrado en la cuenta de Charles: queda como saldo a favor de la barbería.
  PLATFORM
  /// Cobrado directo en la cuenta de Mercado Pago de la barbería (pago dividido).
  SELLER
}

enum BalanceMovementType {
  SUBSCRIPTION_PAYMENT
  PAYOUT
  ADJUSTMENT
}

/// Movimientos del saldo a favor de la barbería que no salen de una reserva o membresía: pago del
/// plan con saldo, liquidaciones (transferencias de Charles) y ajustes. Monto con signo.
model BalanceMovement {
  id             String              @id @default(uuid(7)) @db.Uuid
  barbershopId   String              @map("barbershop_id") @db.Uuid
  type           BalanceMovementType
  amount         Int
  subscriptionId String?             @map("subscription_id") @db.Uuid
  reference      String?
  note           String?
  createdById    String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([barbershopId, createdAt])
  @@index([subscriptionId])
  @@map("balance_movements")
}
