  tier         ClientTier @default(NONE)
  score        Int        @default(0)
  visitsCount  Int        @default(0) @map("visits_count")
  totalSpent   Int        @default(0) @map("total_spent")
  firstVisitAt DateTime?  @map("first_visit_at") @db.Timestamptz(3)
  lastVisitAt  DateTime?  @map("last_visit_at") @db.Timestamptz(3)
  rankedAt     DateTime?  @map("ranked_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
