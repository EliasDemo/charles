// ═════════════════════ Fase 15: planes y suscripciones ═════════════════════

enum PlanAudience {
  BARBERSHOP
  BARBER
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPurpose {
  SUBSCRIPTION
  SPONSOR_PACKAGE
  MEMBERSHIP
}

enum BillingChargeStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/// Plan de suscripción (datos, no código). Uno por público puede ser el plan por defecto (gratis).
model Plan {
  id           String       @id @default(uuid(7)) @db.Uuid
  code         String       @unique
  name         String
  description  String?
  audience     PlanAudience
  /// Céntimos por mes y por año (null: sin opción anual).
  priceMonthly Int          @map("price_monthly")
  priceYearly  Int?         @map("price_yearly")
  currency     String       @default("PEN") @db.Char(3)
  trialDays    Int          @default(0) @map("trial_days") @db.SmallInt
  /// Comisión por reserva en puntos básicos (500 = 5 %). null: la general (`fees.percent_bp`).
  commissionBp Int?         @map("commission_bp")
  sortOrder    Int          @default(0) @map("sort_order")
  isVisible    Boolean      @default(true) @map("is_visible")
  isActive     Boolean      @default(true) @map("is_active")
  isDefault    Boolean      @default(false) @map("is_default")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@index([audience, sortOrder])
  @@map("plans")
}

/// Beneficio de un plan. Límites: valor numérico (null = ilimitado). Interruptores: 1 o 0.
model PlanEntitlement {
  id        String   @id @default(uuid(7)) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String
  value     Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_entitlements")
}

/// Suscripción de una barbería (o de un barbero independiente: barbería INDEPENDENT) a un plan.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  barbershopId           String             @map("barbershop_id") @db.Uuid
  payerUserId            String             @map("payer_user_id") @db.Uuid
  interval               BillingInterval
  status                 SubscriptionStatus @default(PENDING)
  /// Precio vigente (céntimos); un cambio de precio aplica desde la renovación siguiente.
  priceAmount            Int                @map("price_amount")
  currency               String             @db.Char(3)
  nextPriceAmount        Int?               @map("next_price_amount")
  nextPriceFrom          DateTime?          @map("next_price_from") @db.Timestamptz(3)
  provider               String
  providerSubscriptionId String?            @map("provider_subscription_id")
  checkoutUrl            String?            @map("checkout_url")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(3)
  graceUntil             DateTime?          @map("grace_until") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(3)
  cancelReason           String?            @map("cancel_reason")
  endedAt                DateTime?          @map("ended_at") @db.Timestamptz(3)
  metadata               Json               @default("{}")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan             Plan              @relation(fields: [planId], references: [id])
  barbershop       Barbershop        @relation(fields: [barbershopId], references: [id])
  payer            User              @relation("SubscriptionPayer", fields: [payerUserId], references: [id])
  charges          BillingCharge[]
  balanceMovements BalanceMovement[]

  @@unique([provider, providerSubscriptionId])
  @@index([barbershopId, status])
  @@index([planId])
  @@index([payerUserId])
  @@index([status, graceUntil])
  @@map("subscriptions")
}

/// Cobro de facturación de Charles (suscripción, paquete de auspiciador o membresía).
model BillingCharge {
  id                String              @id @default(uuid(7)) @db.Uuid
  purpose           BillingPurpose
  subscriptionId    String?             @map("subscription_id") @db.Uuid
  membershipId      String?             @map("membership_id") @db.Uuid
  sponsorPurchaseId String?             @map("sponsor_purchase_id") @db.Uuid
  amount            Int
  currency          String              @db.Char(3)
  status            BillingChargeStatus @default(PENDING)
  provider          String
  providerPaymentId String?             @map("provider_payment_id")
  failureReason     String?             @map("failure_reason")
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription    Subscription?           @relation(fields: [subscriptionId], references: [id])
  membership      Membership?             @relation(fields: [membershipId], references: [id])
  sponsorPurchase SponsorPackagePurchase? @relation(fields: [sponsorPurchaseId], references: [id])
  creditLot       MembershipCreditLot?

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId])
  @@index([membershipId])
  @@index([sponsorPurchaseId])
  @@map("billing_charges")
}

/// Avisos de la pasarela de facturación ya procesados (idempotencia).
model BillingEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  kind            String
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

enum SponsorPurchaseStatus {
  PENDING
  PAID
  CANCELED
}

/// Paquete publicitario para auspiciadores (catálogo de ADMIN).
model SponsorPackage {
  id               String   @id @default(uuid(7)) @db.Uuid
  code             String   @unique
  name             String
  description      String?
  priceAmount      Int      @map("price_amount")
  currency         String   @default("PEN") @db.Char(3)
  /// Impresiones incluidas (null: sin tope).
  impressionsLimit Int?     @map("impressions_limit")
  placementsLimit  Int      @map("placements_limit") @db.SmallInt
  durationDays     Int      @map("duration_days") @db.SmallInt
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases SponsorPackagePurchase[]

  @@map("sponsor_packages")
}

/// Compra de un paquete: al pagarse, activa la campaña con sus topes.
model SponsorPackagePurchase {
  id            String                @id @default(uuid(7)) @db.Uuid
  sponsorId     String                @map("sponsor_id") @db.Uuid
  packageId     String                @map("package_id") @db.Uuid
  campaignId    String?               @unique @map("campaign_id") @db.Uuid
  priceAmount   Int                   @map("price_amount")
  currency      String                @db.Char(3)
  status        SponsorPurchaseStatus @default(PENDING)
  checkoutUrl   String?               @map("checkout_url")
  /// Correo al que se envió el enlace de pago (cifrado).
  payerEmailEnc String?               @map("payer_email_enc")
  paidAt        DateTime?             @map("paid_at") @db.Timestamptz(3)
  createdById   String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sponsor  Sponsor          @relation(fields: [sponsorId], references: [id])
  package  SponsorPackage   @relation(fields: [packageId], references: [id])
  campaign SponsorCampaign? @relation(fields: [campaignId], references: [id])
  charges  BillingCharge[]

  @@index([sponsorId])
  @@index([packageId])
  @@map("sponsor_package_purchases")
}

// ═════════════════════ Panel de gestión de la barbería ═════════════════════

enum ClientTier {
  NONE
  BRONZE
  SILVER
  GOLD
}

/// Cliente de una barbería (con cuenta en la app o registrado en el local). Sus datos los ve solo
/// esa barbería.
