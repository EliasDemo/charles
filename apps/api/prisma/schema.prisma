// Esquema de Charles (CLAUDE.md §7). Todo cambio va por migración (`prisma migrate dev`).
//
// Convenciones:
// - Modelos en PascalCase y campos en camelCase, mapeados a tablas/columnas snake_case.
// - `id` UUID v7 generado por Prisma (PostgreSQL 16 no tiene uuidv7()).
// - Dinero en enteros (céntimos) + `currency` ISO 4217. Fechas en UTC (timestamptz).
// - Columnas cifradas `*_enc` (texto `v{n}:{iv}:{tag}:{cifrado}`) e índices ciegos `*_hash` (bytea).
// - Restricciones que Prisma no expresa (CHECK, EXCLUDE, índices parciales, triggers) están
//   en SQL manual dentro de las migraciones; ver CLAUDE.md §7.3.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CLIENT
  BARBER
  OWNER
  SUPPORT
  /// Fase 12: administra roles de soporte, ajustes, categorías y reembolsos manuales.
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// PENDING_REVIEW: barbería nueva a la espera de aprobación de soporte (si `barbershops.require_review`).
/// PENDING_REVIEW y SUSPENDED no son visibles públicamente.
enum BarbershopStatus {
  OPEN
  TEMPORARILY_CLOSED
  SUSPENDED
  PENDING_REVIEW
  /// Alta en preparación: falta enviarla a revisión (no visible).
  DRAFT
  /// Revisión rechazada con motivo: el dueño corrige y reenvía (no visible).
  CHANGES_REQUESTED
}

/// Documento del responsable de una barbería.
enum OwnerDocumentType {
  RUC
  DNI
}

/// Decisión sobre un envío a revisión.
enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// INDEPENDENT: barbero independiente, un solo barbero activo (trigger en SQL manual).
enum BarbershopType {
  BARBERSHOP
  INDEPENDENT
}

enum InvitationKind {
  MEMBER
  BARBER
}

enum BarbershopMemberRole {
  OWNER
  MANAGER
}

enum TimeBlockType {
  BREAK
  ABSENCE
  HOLIDAY
  MANUAL
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
  EXPIRED
}

/// Quién canceló una reserva: la devolución depende de ello (Fase 8).
enum CancelledByRole {
  CLIENT
  BARBERSHOP
  SYSTEM
  /// Fase 12: cancelada por soporte (suspensión de la barbería), con devolución total.
  SUPPORT
}

/// Fase 8B: quién paga la comisión de Charles en una reserva.
enum CommissionPayer {
  CLIENT
  BARBERSHOP
}

enum PriceLineType {
  SERVICE
  DISCOUNT
  FEE
  TAX
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  REJECTED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Origen de un reembolso (la política de la Fase 8A depende de él).
enum RefundReason {
  CLIENT_CANCELLATION
  BARBERSHOP_CANCELLATION
  ORPHANED_PAYMENT
  MANUAL
  /// Fase 12: cancelación por soporte (suspensión de la barbería).
  SUPPORT_CANCELLATION
}

/// Revisión de soporte de una cancelación hecha por la barbería (sanción, Fase 8A/12).
enum CancellationReviewStatus {
  PENDING_REVIEW
  JUSTIFIED
  UNJUSTIFIED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  UNDER_REVIEW
}

/// Fase 12: motivo de un reporte de barbería (lista cerrada).
enum BarbershopReportReason {
  FRAUD
  MISLEADING_INFO
  INAPPROPRIATE
  NOT_OPERATING
  SAFETY
  OTHER
}

/// Fase 11: motivo de un reporte de valoración o de su respuesta (lista cerrada).
enum ReviewReportReason {
  OFFENSIVE
  PERSONAL_DATA
  FAKE
  SPAM
  OTHER
}

/// Fase 11: qué se reporta, la valoración o la respuesta de la barbería.
enum ReviewReportTarget {
  REVIEW
  RESPONSE
}

/// Fase 10: estado de entrega de una notificación (IN_APP nace SENT).
enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum TicketCategory {
  ACCOUNT
  BOOKING
  PAYMENT
  BARBERSHOP
  REVIEW
  APP
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

/// Fase 14: tipo de imagen. Logo, portada y foto de barbero: una vigente por dueño.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ImageKind {
  BARBERSHOP_LOGO
  BARBERSHOP_COVER
  BARBER_PHOTO
  GALLERY
}

enum ImageReportReason {
  NOT_MY_PHOTO
  NO_CONSENT
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum PromotionScope {
  PLATFORM
  BARBERSHOP
  SERVICE
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountFunder {
  CHARLES
  BARBERSHOP
}

enum SponsorCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum SponsorAudience {
  CLIENTS
  BARBERSHOPS
  ALL
}

enum SponsorEventType {
  IMPRESSION
  CLICK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ───────────────────────────── Cuentas ─────────────────────────────

model User {
  id                    String     @id @default(uuid(7)) @db.Uuid
  emailEnc              String     @map("email_enc")
  emailHash             Bytes      @unique @map("email_hash")
  passwordHash          String     @map("password_hash")
  fullName              String     @map("full_name")
  /// Nombre de usuario público y para iniciar sesión (único, sin distinguir mayúsculas). Lo que
  /// ven otras personas en lugar del nombre real.
  username              String     @unique @db.Citext
  /// Último cambio del nombre de usuario (se puede cambiar una vez cada 30 días).
  usernameChangedAt     DateTime?  @map("username_changed_at") @db.Timestamptz(3)
  phoneEnc              String?    @map("phone_enc")
  phoneHash             Bytes?     @map("phone_hash")
  documentNumberEnc     String?    @map("document_number_enc")
  /// Único solo cuando no es nulo: índice único parcial en SQL manual (users_document_hash_key).
  documentHash          Bytes?     @map("document_hash")
  birthDateEnc          String?    @map("birth_date_enc")
  /// Perfil: opcional. Uso declarado: sugerir estilos. Nunca visible para las barberías.
  gender                Gender?
  /// Forma de cara del cliente, solo si activó "recordar mi forma de cara" (dato biométrico).
  faceShape             FaceShape? @map("face_shape")
  faceShapeConsentAt    DateTime?  @map("face_shape_consent_at") @db.Timestamptz(3)
  /// Perfil: foto de la cuenta (variantes en el almacenamiento, como `images.variants`).
  photoVariants         Json?      @map("photo_variants")
  status                UserStatus @default(ACTIVE)
  /// Nulo = correo sin verificar (se exige verificado para reservar, Fase 7).
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Declaración de mayoría de edad (18+) al aceptar los términos (ADR 0003). El registro siempre la
  /// exige; nulo solo en cuentas creadas antes de esta regla.
  adultDeclaredAt       DateTime?  @map("adult_declared_at") @db.Timestamptz(3)
  termsAcceptedAt       DateTime   @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion          String     @map("terms_version")
  preferences           Json       @default("{}")
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// Eliminación de cuenta (Apple y Google): solicitada y programada tras el periodo de gracia.
  /// Mientras `deletionScheduledFor` no es nulo, la cuenta está pendiente de eliminación.
  deletionRequestedAt   DateTime?  @map("deletion_requested_at") @db.Timestamptz(3)
  deletionScheduledFor  DateTime?  @map("deletion_scheduled_for") @db.Timestamptz(3)
  deletionRemindedAt    DateTime?  @map("deletion_reminded_at") @db.Timestamptz(3)
  deletionFinalNoticeAt DateTime?  @map("deletion_final_notice_at") @db.Timestamptz(3)
  /// Datos personales borrados o anonimizados (irreversible).
  anonymizedAt          DateTime?  @map("anonymized_at") @db.Timestamptz(3)

  roles                     UserRole[]
  reviewSubmissions         BarbershopReviewSubmission[]   @relation("ReviewSubmitter")
  reviewDecisions           BarbershopReviewSubmission[]   @relation("ReviewDecider")
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationCodes    EmailVerificationCode[]
  deviceTokens              DeviceToken[]
  memberships               BarbershopMember[]
  invitationsReceived       BarbershopInvitation[]         @relation("InvitationInvitee")
  invitationsSent           BarbershopInvitation[]         @relation("InvitationInviter")
  barberProfiles            Barber[]
  bookings                  Booking[]                      @relation("BookingClient")
  cancelledBookings         Booking[]                      @relation("BookingCancelledBy")
  cancellationsByMe         BarbershopCancellationReview[] @relation("CancellationReviewCancelledBy")
  cancellationsReviewed     BarbershopCancellationReview[] @relation("CancellationReviewReviewedBy")
  bookingStatusChanges      BookingStatusHistory[]
  favorites                 Favorite[]
  reviews                   Review[]                       @relation("ReviewClient")
  reviewResponses           Review[]                       @relation("ReviewResponder")
  reviewReports             ReviewReport[]
  notifications             Notification[]
  supportTickets            SupportTicket[]                @relation("TicketRequester")
  assignedTickets           SupportTicket[]                @relation("TicketAssignee")
  ticketMessages            TicketMessage[]
  barbershopReports         BarbershopReport[]             @relation("BarbershopReportReporter")
  barbershopReportsResolved BarbershopReport[]             @relation("BarbershopReportResolver")
  imagesUploaded            Image[]                        @relation("ImageUploader")
  imagesConsented           Image[]                        @relation("ImageConsent")
  imageReports              ImageReport[]                  @relation("ImageReportReporter")
  imageReportsResolved      ImageReport[]                  @relation("ImageReportResolver")
  promotionRedemptions      PromotionRedemption[]
  promotionsCreated         Promotion[]                    @relation("PromotionCreator")
  sponsorEvents             SponsorEvent[]

  mfa              UserMfa?
  mfaRecoveryCodes MfaRecoveryCode[]

  barberProfile          BarberProfile?
  conversations          Conversation[]    @relation("ConversationUser")
  messagesSent           Message[]         @relation("MessageSender")
  messageReports         MessageReport[]   @relation("MessageReporter")
  messageReportsResolved MessageReport[]   @relation("MessageReportResolver")
  jobPostingsCreated     JobPosting[]      @relation("JobPostingCreator")
  videosUploaded         Video[]           @relation("VideoUploader")
  featuredCreated        FeaturedListing[] @relation("FeaturedCreator")

  @@index([phoneHash])
  @@map("users")
}

/// Índice ciego del correo de una cuenta deshabilitada por soporte que pidió su eliminación: no
/// puede registrarse de nuevo hasta `blockedUntil`. Ningún otro dato.
model EmailBlocklist {
  id           String   @id @default(uuid(7)) @db.Uuid
  emailHash    Bytes    @unique @map("email_hash")
  blockedUntil DateTime @map("blocked_until") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([blockedUntil])
  @@map("email_blocklist")
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

/// Verificación en dos pasos (TOTP) del personal. Sin `enabledAt` = activación pendiente.
model UserMfa {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(3)
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Códigos de recuperación del segundo factor: solo su HMAC, un solo uso.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         Bytes     @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy        String?   @map("replaced_by") @db.Uuid
  deviceInfo        Json?     @map("device_info")
  /// `pwd` = contraseña; `mfa` = sesión de personal con segundo factor (12 h máx., 30 min de inactividad).
  amr               String    @default("pwd")
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Código de recuperación de 6 dígitos: solo su HMAC; inválido tras 5 intentos fallidos.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @map("token_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  platform      DevicePlatform
  /// Fase 10: token de Expo cifrado (nunca en claro ni en logs) e índice ciego para unicidad.
  pushTokenEnc  String         @map("push_token_enc")
  pushTokenHash Bytes          @unique @map("push_token_hash")
  appVersion    String?        @map("app_version")
  /// Sesión que lo registró: al cerrarla se borra el token.
  sessionId     String?        @map("session_id") @db.Uuid
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([sessionId])
  @@map("device_tokens")
}

/// Código de verificación de correo de 6 dígitos: solo su HMAC; inválido tras 5 intentos fallidos.
model EmailVerificationCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

// ─────────────────── Barberías, barberos y servicios ───────────────────

model Barbershop {
  id                   String                                @id @default(uuid(7)) @db.Uuid
  name                 String
  description          String?
  address              String
  latitude             Float
  longitude            Float
  /// Columna generada en SQL: ST_MakePoint(longitude, latitude)::geography. Índice GiST.
  location             Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(longitude, latitude), 4326))::geography"))
  timezone             String
  phone                String?
  /// Documento del responsable (RUC o DNI): cifrado, con índice ciego (no único). Lo ve solo el
  /// OWNER (enmascarado) y soporte con motivo y auditoría.
  ownerDocumentType    OwnerDocumentType?                    @map("owner_document_type")
  ownerDocumentEnc     String?                               @map("owner_document_enc")
  ownerDocumentHash    Bytes?                                @map("owner_document_hash")
  /// Último envío a revisión pendiente, y motivo de la última solicitud de cambios.
  submittedForReviewAt DateTime?                             @map("submitted_for_review_at") @db.Timestamptz(3)
  reviewNotes          String?                               @map("review_notes")
  websiteUrl           String?                               @map("website_url")
  instagramUrl         String?                               @map("instagram_url")
  facebookUrl          String?                               @map("facebook_url")
  type                 BarbershopType                        @default(BARBERSHOP)
  status               BarbershopStatus                      @default(OPEN)
  /// Solo con TEMPORARILY_CLOSED (CHECK en SQL manual).
  closureReason        String?                               @map("closure_reason")
  expectedReopenAt     DateTime?                             @map("expected_reopen_at") @db.Timestamptz(3)
  ratingAvg            Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                                   @default(0) @map("rating_count")
  /// Fase 12: marcada para revisión de soporte por el sistema (por ejemplo `owner_disabled`).
  flaggedReason        String?                               @map("flagged_reason")
  flaggedAt            DateTime?                             @map("flagged_at") @db.Timestamptz(3)
  metadata             Json                                  @default("{}")
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                             @map("deleted_at") @db.Timestamptz(3)

  members             BarbershopMember[]
  barbers             Barber[]
  services            Service[]
  businessHours       BusinessHour[]
  timeBlocks          TimeBlock[]
  bookings            Booking[]
  favorites           Favorite[]
  reviews             Review[]
  reports             BarbershopReport[]
  featuredListings    FeaturedListing[]
  promotions          Promotion[]
  invitations         BarbershopInvitation[]
  cancellationReviews BarbershopCancellationReview[]
  reviewSubmissions   BarbershopReviewSubmission[]
  images              Image[]

  conversations Conversation[]
  jobPostings   JobPosting[]
  videos        Video[]

  @@index([location], type: Gist)
  @@map("barbershops")
}

/// Historial de envíos a revisión del alta y sus decisiones.
model BarbershopReviewSubmission {
  id            String          @id @default(uuid(7)) @db.Uuid
  barbershopId  String          @map("barbershop_id") @db.Uuid
  submittedById String          @map("submitted_by") @db.Uuid
  submittedAt   DateTime        @map("submitted_at") @db.Timestamptz(3)
  decision      ReviewDecision?
  decidedById   String?         @map("decided_by") @db.Uuid
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(3)
  reason        String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop  Barbershop @relation(fields: [barbershopId], references: [id])
  submittedBy User       @relation("ReviewSubmitter", fields: [submittedById], references: [id])
  decidedBy   User?      @relation("ReviewDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([barbershopId, submittedAt])
  @@index([submittedById])
  @@index([decidedById])
  @@map("barbershop_review_submissions")
}

model BarbershopMember {
  id           String               @id @default(uuid(7)) @db.Uuid
  barbershopId String               @map("barbershop_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  role         BarbershopMemberRole
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([barbershopId, userId])
  @@index([userId])
  @@map("barbershop_members")
}

/// Invitación con código de 6 dígitos (solo su HMAC; 1 uso; vence; inválida tras 5 intentos) para:
/// - MEMBER: ser responsable (OWNER o MANAGER) de la barbería;
/// - BARBER: vincular una cuenta a un perfil de barbero.
model BarbershopInvitation {
  id            String                @id @default(uuid(7)) @db.Uuid
  barbershopId  String                @map("barbershop_id") @db.Uuid
  kind          InvitationKind
  memberRole    BarbershopMemberRole? @map("member_role")
  barberId      String?               @map("barber_id") @db.Uuid
  invitedUserId String                @map("invited_user_id") @db.Uuid
  invitedById   String                @map("invited_by") @db.Uuid
  codeHash      Bytes                 @map("code_hash")
  attempts      Int                   @default(0)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(3)
  acceptedAt    DateTime?             @map("accepted_at") @db.Timestamptz(3)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop  Barbershop @relation(fields: [barbershopId], references: [id])
  barber      Barber?    @relation(fields: [barberId], references: [id])
  invitedUser User       @relation("InvitationInvitee", fields: [invitedUserId], references: [id])
  invitedBy   User       @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([barbershopId])
  @@index([barberId])
  @@index([invitedUserId])
  @@index([invitedById])
  @@map("barbershop_invitations")
}

/// Un barbero pertenece a una sola barbería en el MVP: índice único parcial
/// `barbers_user_id_active_key` en SQL manual (se elimina para permitir varias barberías).
model Barber {
  id              String    @id @default(uuid(7)) @db.Uuid
  barbershopId    String    @map("barbershop_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  displayName     String    @map("display_name")
  phoneEnc        String?   @map("phone_enc")
  bio             String?
  photoUrl        String?   @map("photo_url")
  isActive        Boolean   @default(true) @map("is_active")
  /// Fase 11: promedio y cantidad de valoraciones visibles; se recalculan en la misma transacción.
  ratingAvg       Decimal   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int       @default(0) @map("rating_count")
  /// Fase 14: años de experiencia (0–60), opcional.
  yearsExperience Int?      @map("years_experience") @db.SmallInt
  /// Carrera del barbero: perfil profesional de la persona (null si el barbero no tiene cuenta).
  barberProfileId String?   @map("barber_profile_id") @db.Uuid
  /// Fin del vínculo (el barbero se fue o lo desvincularon). El progreso queda en su perfil.
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  barbershop  Barbershop             @relation(fields: [barbershopId], references: [id])
  user        User?                  @relation(fields: [userId], references: [id])
  services    BarberService[]
  schedules   BarberSchedule[]
  timeBlocks  TimeBlock[]
  bookings    Booking[]
  reviews     Review[]
  invitations BarbershopInvitation[]
  images      Image[]
  specialties BarberSpecialty[]

  barberProfile BarberProfile? @relation(fields: [barberProfileId], references: [id])

  @@index([barberProfileId])
  @@index([barbershopId])
  @@index([userId])
  @@map("barbers")
}

model Service {
  id              String    @id @default(uuid(7)) @db.Uuid
  barbershopId    String    @map("barbershop_id") @db.Uuid
  name            String
  description     String?
  priceAmount     Int       @map("price_amount")
  currency        String    @db.Char(3)
  durationMinutes Int       @map("duration_minutes")
  isAvailable     Boolean   @default(true) @map("is_available")
  categoryId      String    @map("category_id") @db.Uuid
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  barbershop Barbershop      @relation(fields: [barbershopId], references: [id])
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  barbers    BarberService[]
  bookings   Booking[]
  images     Image[]

  @@index([barbershopId])
  @@index([categoryId])
  @@map("services")
}

/// Categorías de servicio (tabla, no enum: se amplía sin migrar). Las alternativas de
/// RF-BUS-004 comparan por categoría.
model ServiceCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  services Service[]
  styles   ServiceStyle[]

  @@map("service_categories")
}

/// Fase 14: estilos (degradado, barba candado…) por categoría; etiquetan fotos y especialidades.
model ServiceStyle {
  id          String            @id @default(uuid(7)) @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  key         String            @unique
  name        String
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  /// Forma de cara: descripción, mantenimiento, tipos de cabello y estilo (clásico o moderno).
  description String?
  maintenance MaintenanceLevel?
  hairTypes   HairType[]        @map("hair_types")
  vibe        StyleVibe?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    ServiceCategory   @relation(fields: [categoryId], references: [id])
  images      ImageStyle[]
  specialties BarberSpecialty[]

  profileSpecialties BarberProfileSpecialty[]

  faceShapeRules FaceShapeRule[]
  bookings       Booking[]

  @@index([categoryId])
  @@map("service_styles")
}

/// Fase 14: hasta 5 por barbero.
model BarberSpecialty {
  id        String   @id @default(uuid(7)) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  styleId   String   @map("style_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  style  ServiceStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([barberId, styleId])
  @@index([styleId])
  @@map("barber_specialties")
}

/// Fase 14: imágenes. `variants`: { thumb|large|square: { key, width, height } } (claves aleatorias
/// en el almacenamiento). La galería exige el consentimiento de la persona fotografiada, declarado
/// por quien sube. Se oculta sola con N reportes abiertos (se calcula, no se guarda).
model Image {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// null: foto del portafolio que el barbero subió desde su perfil (sin barbería).
  barbershopId     String?    @map("barbershop_id") @db.Uuid
  /// Carrera del barbero: portafolio (sus cortes). Es del barbero, no de la barbería.
  barberProfileId  String?    @map("barber_profile_id") @db.Uuid
  barberId         String?    @map("barber_id") @db.Uuid
  kind             ImageKind
  variants         Json
  uploadedById     String     @map("uploaded_by") @db.Uuid
  consentGiven     Boolean    @default(false) @map("consent_given")
  consentByUserId  String?    @map("consent_by_user_id") @db.Uuid
  consentTimestamp DateTime?  @map("consent_timestamp") @db.Timestamptz(3)
  caption          String?
  /// Forma de cara de la persona fotografiada (la marca el barbero). Solo en cortes (GALLERY).
  faceShape        FaceShape? @map("face_shape")
  /// Etiquetas (estilos y forma) confirmadas por el barbero: ejemplo válido para recomendar y entrenar.
  labelConfirmed   Boolean    @default(false) @map("label_confirmed")
  /// Foto de demostración (stock): nunca se presenta como trabajo real.
  isDemo           Boolean    @default(false) @map("is_demo")
  /// Atribución de la foto de demostración (fotógrafo y enlace en la fuente).
  demoSource       Json?      @map("demo_source")
  /// Servicio para "reservar este estilo" desde la foto.
  serviceId        String?    @map("service_id") @db.Uuid
  pinnedAt         DateTime?  @map("pinned_at") @db.Timestamptz(3)
  /// Retirada por soporte (moderación): no se muestra aunque no tenga reportes.
  removedAt        DateTime?  @map("removed_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  barbershop Barbershop?   @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  barber     Barber?       @relation(fields: [barberId], references: [id])
  uploadedBy User          @relation("ImageUploader", fields: [uploadedById], references: [id])
  consentBy  User?         @relation("ImageConsent", fields: [consentByUserId], references: [id])
  service    Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  styles     ImageStyle[]
  reports    ImageReport[]

  barberProfile BarberProfile? @relation(fields: [barberProfileId], references: [id])

  @@index([barberProfileId])
  @@index([barbershopId, kind])
  @@index([barberId, kind])
  @@index([uploadedById])
  @@index([consentByUserId])
  @@index([serviceId])
  @@map("images")
}

model ImageStyle {
  id        String   @id @default(uuid(7)) @db.Uuid
  imageId   String   @map("image_id") @db.Uuid
  styleId   String   @map("style_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  image Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  style ServiceStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([imageId, styleId])
  @@index([styleId])
  @@map("image_styles")
}

model ImageReport {
  id           String            @id @default(uuid(7)) @db.Uuid
  imageId      String            @map("image_id") @db.Uuid
  reportedById String            @map("reported_by") @db.Uuid
  reason       ImageReportReason
  details      String?
  status       ReportStatus      @default(OPEN)
  resolution   String?
  resolvedById String?           @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  image      Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  reportedBy User  @relation("ImageReportReporter", fields: [reportedById], references: [id])
  resolvedBy User? @relation("ImageReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([imageId, reportedById])
  @@index([reportedById])
  @@index([resolvedById])
  @@index([status, createdAt])
  @@map("image_reports")
}

model BarberService {
  id        String   @id @default(uuid(7)) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@index([serviceId])
  @@map("barber_services")
}

// ─────────────────── Horarios y disponibilidad ───────────────────

/// `day_of_week`: 0 = domingo … 6 = sábado. Horas locales en la zona de la barbería.
model BusinessHour {
  id           String   @id @default(uuid(7)) @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  openTime     DateTime @map("open_time") @db.Time(0)
  closeTime    DateTime @map("close_time") @db.Time(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, dayOfWeek])
  @@map("business_hours")
}

/// Varias filas por día permiten descansos. `day_of_week`: 0 = domingo … 6 = sábado.
model BarberSchedule {
  id        String   @id @default(uuid(7)) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
  @@map("barber_schedules")
}

/// `barber_id` nulo = bloqueo de toda la barbería.
model TimeBlock {
  id           String        @id @default(uuid(7)) @db.Uuid
  barbershopId String        @map("barbershop_id") @db.Uuid
  barberId     String?       @map("barber_id") @db.Uuid
  startAt      DateTime      @map("start_at") @db.Timestamptz(3)
  endAt        DateTime      @map("end_at") @db.Timestamptz(3)
  type         TimeBlockType
  reason       String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barbershopId, startAt])
  @@index([barberId, startAt])
  @@map("time_blocks")
}

// ───────────────────────────── Reservas ─────────────────────────────

/// Solapamiento imposible para reservas activas del mismo barbero: EXCLUDE `bookings_no_overlap` (§7.3).
model Booking {
  id                      String           @id @default(uuid(7)) @db.Uuid
  clientId                String           @map("client_id") @db.Uuid
  barbershopId            String           @map("barbershop_id") @db.Uuid
  barberId                String           @map("barber_id") @db.Uuid
  /// Carrera del barbero: su perfil, para no cruzar citas entre barberías (restricción de exclusión).
  barberProfileId         String?          @map("barber_profile_id") @db.Uuid
  /// Forma de cara: corte elegido al reservar (opcional), para medir las estrellas por corte.
  styleId                 String?          @map("style_id") @db.Uuid
  serviceId               String           @map("service_id") @db.Uuid
  startAt                 DateTime         @map("start_at") @db.Timestamptz(3)
  endAt                   DateTime         @map("end_at") @db.Timestamptz(3)
  status                  BookingStatus    @default(PENDING_PAYMENT)
  barberChosenByClient    Boolean          @map("barber_chosen_by_client")
  serviceNameSnapshot     String           @map("service_name_snapshot")
  durationMinutesSnapshot Int              @map("duration_minutes_snapshot")
  subtotalAmount          Int              @map("subtotal_amount")
  discountTotalAmount     Int              @default(0) @map("discount_total_amount")
  feeTotalAmount          Int              @default(0) @map("fee_total_amount")
  totalAmount             Int              @map("total_amount")
  /// Fase 8B: comisión de Charles (céntimos) y quién la paga, congeladas al reservar.
  commissionAmount        Int              @default(0) @map("commission_amount")
  commissionPayer         CommissionPayer? @map("commission_payer")
  currency                String           @db.Char(3)
  expiresAt               DateTime?        @map("expires_at") @db.Timestamptz(3)
  cancelledById           String?          @map("cancelled_by") @db.Uuid
  cancelledByRole         CancelledByRole? @map("cancelled_by_role")
  cancelReason            String?          @map("cancel_reason")
  idempotencyKey          String           @map("idempotency_key")
  metadata                Json             @default("{}")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client              User                          @relation("BookingClient", fields: [clientId], references: [id])
  barbershop          Barbershop                    @relation(fields: [barbershopId], references: [id])
  barber              Barber                        @relation(fields: [barberId], references: [id])
  service             Service                       @relation(fields: [serviceId], references: [id])
  cancelledBy         User?                         @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  priceLines          BookingPriceLine[]
  statusHistory       BookingStatusHistory[]
  payments            Payment[]
  review              Review?
  promotionRedemption PromotionRedemption?
  cancellationReview  BarbershopCancellationReview?

  barberProfile BarberProfile? @relation(fields: [barberProfileId], references: [id])

  style ServiceStyle? @relation(fields: [styleId], references: [id])

  @@unique([clientId, idempotencyKey])
  @@index([styleId])
  @@index([barberProfileId, startAt])
  @@index([clientId, startAt])
  @@index([barbershopId, startAt])
  @@index([barberId, startAt])
  @@index([serviceId])
  @@index([cancelledById])
  @@index([status, expiresAt])
  @@map("bookings")
}

/// `amount` siempre ≥ 0; el tipo define cómo cuenta. Las líneas TAX son informativas (ADR 0002).
model BookingPriceLine {
  id          String        @id @default(uuid(7)) @db.Uuid
  bookingId   String        @map("booking_id") @db.Uuid
  type        PriceLineType
  description String
  amount      Int
  sourceType  String?       @map("source_type")
  sourceId    String?       @map("source_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_price_lines")
}

/// `changed_by` nulo = cambio hecho por el sistema.
model BookingStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  changedById String?        @map("changed_by") @db.Uuid
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([bookingId, createdAt])
  @@index([changedById])
  @@map("booking_status_history")
}

// ───────────────────────────── Pagos ─────────────────────────────
// Independiente del proveedor (ADR 0002): `provider` es texto (FAKE, IZIPAY, ...).

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @db.Char(3)
  method            String?
  idempotencyKey    String        @map("idempotency_key")
  /// Momento en que la pasarela aceptó el pago (null = aún no se inició). Lo usa la conciliación.
  startedAt         DateTime?     @map("started_at") @db.Timestamptz(3)
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking        @relation(fields: [bookingId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@unique([bookingId, idempotencyKey])
  @@map("payments")
}

/// `payload` nunca contiene datos de tarjeta.
model PaymentEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  paymentId       String?   @map("payment_id") @db.Uuid
  type            String
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

/// La suma de los reembolsos no fallidos de un pago nunca supera su importe (trigger en SQL).
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Int
  reasonType       RefundReason @map("reason_type")
  /// Detalle libre (nunca datos personales).
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  /// Misma clave = mismo reembolso en la pasarela (reintentos sin duplicar).
  idempotencyKey   String       @unique @map("idempotency_key")
  /// Momento en que la pasarela aceptó la solicitud (null = aún no se envió).
  requestedAt      DateTime?    @map("requested_at") @db.Timestamptz(3)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Cancelación hecha por la barbería, pendiente de calificar por soporte (sanción).
model BarbershopCancellationReview {
  id            String                   @id @default(uuid(7)) @db.Uuid
  bookingId     String                   @unique @map("booking_id") @db.Uuid
  barbershopId  String                   @map("barbershop_id") @db.Uuid
  cancelledById String                   @map("cancelled_by") @db.Uuid
  reason        String
  cancelledAt   DateTime                 @map("cancelled_at") @db.Timestamptz(3)
  status        CancellationReviewStatus @default(PENDING_REVIEW)
  reviewedById  String?                  @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking    @relation(fields: [bookingId], references: [id])
  barbershop  Barbershop @relation(fields: [barbershopId], references: [id])
  cancelledBy User       @relation("CancellationReviewCancelledBy", fields: [cancelledById], references: [id])
  reviewedBy  User?      @relation("CancellationReviewReviewedBy", fields: [reviewedById], references: [id])

  @@index([barbershopId, status, cancelledAt])
  @@index([cancelledById])
  @@index([reviewedById])
  @@map("barbershop_cancellation_reviews")
}

// ─────────────────────── Experiencia del cliente ───────────────────────

model Favorite {
  id           String   @id @default(uuid(7)) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     User       @relation(fields: [clientId], references: [id])
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  @@unique([clientId, barbershopId])
  @@index([barbershopId])
  @@map("favorites")
}

model Review {
  id              String        @id @default(uuid(7)) @db.Uuid
  bookingId       String        @unique @map("booking_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  barbershopId    String        @map("barbershop_id") @db.Uuid
  barberId        String        @map("barber_id") @db.Uuid
  /// Carrera del barbero: la valoración cuenta para su perfil, también si después se va.
  barberProfileId String?       @map("barber_profile_id") @db.Uuid
  rating          Int           @db.SmallInt
  comment         String?
  status          ReviewStatus  @default(VISIBLE)
  /// Por qué está oculta: `attendance_corrected` (se restaura sola) o `moderation` (soporte).
  hiddenReason    String?       @map("hidden_reason")
  /// Única edición permitida (Fase 11); la fecha original no cambia.
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(3)
  /// Respuesta de la barbería (una por valoración, editable). Las cuatro columnas van juntas (CHECK).
  responseText    String?       @map("response_text")
  responseById    String?       @map("response_by") @db.Uuid
  responseAt      DateTime?     @map("response_at") @db.Timestamptz(3)
  responseStatus  ReviewStatus? @map("response_status")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  booking    Booking        @relation(fields: [bookingId], references: [id])
  client     User           @relation("ReviewClient", fields: [clientId], references: [id])
  responseBy User?          @relation("ReviewResponder", fields: [responseById], references: [id], onDelete: Restrict)
  barbershop Barbershop     @relation(fields: [barbershopId], references: [id])
  barber     Barber         @relation(fields: [barberId], references: [id])
  reports    ReviewReport[]

  barberProfile BarberProfile? @relation(fields: [barberProfileId], references: [id])

  @@index([barberProfileId])
  @@index([clientId])
  @@index([barbershopId, createdAt])
  @@index([barberId])
  @@index([responseById])
  @@map("reviews")
}

model ReviewReport {
  id           String             @id @default(uuid(7)) @db.Uuid
  reviewId     String             @map("review_id") @db.Uuid
  reportedById String             @map("reported_by") @db.Uuid
  target       ReviewReportTarget @default(REVIEW)
  reason       ReviewReportReason
  /// Texto libre opcional del reporte (hasta 500).
  details      String?
  resolvedAt   DateTime?          @map("resolved_at") @db.Timestamptz(3)
  resolution   String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  review     Review @relation(fields: [reviewId], references: [id])
  reportedBy User   @relation(fields: [reportedById], references: [id])

  @@unique([reviewId, target, reportedById])
  @@index([reportedById])
  @@map("review_reports")
}

model Notification {
  id           String              @id @default(uuid(7)) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  type         String
  title        String
  body         String
  /// Navegación para la app: `{ resource: { type, id } }` y datos del aviso.
  data         Json                @default("{}")
  channel      NotificationChannel
  /// Fase 10: idempotencia (evento o recordatorio); única por usuario y canal.
  dedupeKey    String              @map("dedupe_key")
  status       NotificationStatus  @default(PENDING)
  /// No se envía antes (horario silencioso o reintento con espera).
  sendAfter    DateTime            @default(now()) @map("send_after") @db.Timestamptz(3)
  attempts     Int                 @default(0)
  claimedAt    DateTime?           @map("claimed_at") @db.Timestamptz(3)
  /// Código del último error (nunca el contenido).
  lastError    String?             @map("last_error")
  /// Datos del proveedor (por ejemplo, tickets de Expo para consultar recibos).
  providerData Json                @default("{}") @map("provider_data")
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt       DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey, channel])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────── Soporte y operación ───────────────────────

/// `related_type` / `related_id`: referencia polimórfica sin FK (reserva, pago, barbería, ...).
model SupportTicket {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  category     TicketCategory
  subject      String
  status       TicketStatus   @default(OPEN)
  assignedToId String?        @map("assigned_to") @db.Uuid
  relatedType  String?        @map("related_type")
  relatedId    String?        @map("related_id") @db.Uuid
  /// Fase 12: cuándo pasó a RESOLVED (plazo de reapertura y cierre automático) y a CLOSED.
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(3)
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(3)
  metadata     Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User            @relation("TicketRequester", fields: [userId], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   TicketMessage[]

  @@index([userId])
  @@index([assignedToId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  bodyEnc    String   @map("body_enc")
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_messages")
}

model BarbershopReport {
  id           String                 @id @default(uuid(7)) @db.Uuid
  barbershopId String                 @map("barbershop_id") @db.Uuid
  reportedById String                 @map("reported_by") @db.Uuid
  reason       BarbershopReportReason
  /// Texto libre opcional (hasta 500).
  details      String?
  status       ReportStatus           @default(OPEN)
  resolution   String?
  resolvedById String?                @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?              @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  reportedBy User       @relation("BarbershopReportReporter", fields: [reportedById], references: [id])
  resolvedBy User?      @relation("BarbershopReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([barbershopId, reportedById])
  @@index([reportedById])
  @@index([resolvedById])
  @@index([status, createdAt])
  @@map("barbershop_reports")
}

/// Solo inserción (trigger `audit_log_immutable`). Sin FK a users: el registro sobrevive a la cuenta.
/// `changes` nunca contiene datos sensibles.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ip         String?  @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ───────────────────────────── Crecimiento ─────────────────────────────

/// `scope_id` nulo solo con alcance PLATFORM. `value`: porcentaje (1–100) o monto en céntimos.
model Promotion {
  id             String         @id @default(uuid(7)) @db.Uuid
  scope          PromotionScope
  scopeId        String?        @map("scope_id") @db.Uuid
  name           String
  type           PromotionType
  value          Int
  currency       String?        @db.Char(3)
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?      @map("ends_at") @db.Timestamptz(3)
  maxRedemptions Int?           @map("max_redemptions")
  maxPerUser     Int?           @map("max_per_user")
  rules          Json           @default("{}")
  isActive       Boolean        @default(true) @map("is_active")
  /// Fase 13: barbería dueña (también en las de un servicio); null en las de Charles.
  barbershopId   String?        @map("barbershop_id") @db.Uuid
  /// true: solo con cupón. false: se aplica sola.
  requiresCoupon Boolean        @default(false) @map("requires_coupon")
  createdById    String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  coupons     Coupon[]
  redemptions PromotionRedemption[]
  barbershop  Barbershop?           @relation(fields: [barbershopId], references: [id])
  createdBy   User?                 @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([scope, scopeId])
  @@index([barbershopId])
  @@index([createdById])
  @@map("promotions")
}

model Coupon {
  id          String    @id @default(uuid(7)) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  code        String    @unique @db.Citext
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  promotion   Promotion             @relation(fields: [promotionId], references: [id])
  redemptions PromotionRedemption[]

  @@index([promotionId])
  @@map("coupons")
}

model PromotionRedemption {
  id             String         @id @default(uuid(7)) @db.Uuid
  promotionId    String         @map("promotion_id") @db.Uuid
  couponId       String?        @map("coupon_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  bookingId      String         @unique @map("booking_id") @db.Uuid
  discountAmount Int            @map("discount_amount")
  currency       String         @db.Char(3)
  fundedBy       DiscountFunder @map("funded_by")
  /// Reserva cancelada o vencida: el cupo vuelve a estar disponible.
  releasedAt     DateTime?      @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotion Promotion @relation(fields: [promotionId], references: [id])
  coupon    Coupon?   @relation(fields: [couponId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  booking   Booking   @relation(fields: [bookingId], references: [id])

  @@index([promotionId, releasedAt])
  @@index([userId, promotionId])
  @@index([couponId])
  @@map("promotion_redemptions")
}

model Sponsor {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  logoUrl    String?   @map("logo_url")
  contactEnc String?   @map("contact_enc")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  campaigns SponsorCampaign[]
  products  SponsorProduct[]

  @@map("sponsors")
}

model SponsorCampaign {
  id        String                @id @default(uuid(7)) @db.Uuid
  sponsorId String                @map("sponsor_id") @db.Uuid
  name      String
  startsAt  DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime              @map("ends_at") @db.Timestamptz(3)
  target    Json                  @default("{}")
  /// Fase 13: a quién se muestra (clientes, barberías o ambos).
  audience  SponsorAudience       @default(ALL)
  status    SponsorCampaignStatus @default(DRAFT)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?             @map("deleted_at") @db.Timestamptz(3)

  sponsor    Sponsor            @relation(fields: [sponsorId], references: [id])
  placements SponsorPlacement[]

  @@index([sponsorId])
  @@index([status, startsAt, endsAt])
  @@map("sponsor_campaigns")
}

model SponsorPlacement {
  id         String   @id @default(uuid(7)) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  slotKey    String   @map("slot_key")
  title      String
  imageUrl   String?  @map("image_url")
  actionUrl  String?  @map("action_url")
  priority   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign SponsorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   SponsorEvent[]

  @@index([campaignId])
  @@index([slotKey, priority])
  @@map("sponsor_placements")
}

model SponsorEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  placementId String           @map("placement_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  type        SponsorEventType
  /// Fase 13: una impresión o clic por persona (o dispositivo anónimo) por hora. Sin IP.
  viewerHash  Bytes            @map("viewer_hash")
  hourBucket  DateTime         @map("hour_bucket") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  placement SponsorPlacement @relation(fields: [placementId], references: [id])
  user      User?            @relation(fields: [userId], references: [id])

  @@unique([placementId, type, viewerHash, hourBucket])
  @@index([placementId, createdAt])
  @@index([userId])
  @@map("sponsor_events")
}

/// Fase 13: catálogo de productos del auspiciador, con enlace externo. Charles no vende ni cobra.
model SponsorProduct {
  id          String    @id @default(uuid(7)) @db.Uuid
  sponsorId   String    @map("sponsor_id") @db.Uuid
  name        String
  description String?
  imageUrl    String?   @map("image_url")
  actionUrl   String    @map("action_url")
  priceText   String?   @map("price_text")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  @@index([sponsorId])
  @@map("sponsor_products")
}

model FeaturedListing {
  id           String    @id @default(uuid(7)) @db.Uuid
  barbershopId String    @map("barbershop_id") @db.Uuid
  startsAt     DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime  @map("ends_at") @db.Timestamptz(3)
  priority     Int       @default(0)
  /// Fase 13: quién lo asignó (ADMIN) y si se retiró antes de tiempo.
  createdById  String?   @map("created_by") @db.Uuid
  note         String?
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  createdBy  User?      @relation("FeaturedCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([barbershopId])
  @@index([startsAt, endsAt])
  @@index([createdById])
  @@map("featured_listings")
}

/// Clave/valor tipado. `value` puede ser JSON `null` para políticas aún no definidas (§4.2).
model AppSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model FeatureFlag {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(false)
  rules     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ───────────── Carrera del barbero ─────────────

/// Perfil profesional del barbero: es de la persona, no de la barbería. Acumula sus valoraciones,
/// su portafolio y sus especialidades en todas las barberías donde trabaje (y como independiente).
model BarberProfile {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  displayName      String    @map("display_name")
  headline         String?
  bio              String?
  photoVariants    Json?     @map("photo_variants")
  yearsExperience  Int?      @map("years_experience") @db.SmallInt
  /// Distrito o zona donde trabaja (texto libre corto, por ejemplo "Miraflores").
  district         String?
  /// "Disponible para trabajar": aparece en la búsqueda de barberos para las barberías.
  availableForWork Boolean   @default(false) @map("available_for_work")
  ratingAvg        Decimal   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int       @default(0) @map("rating_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  user         User                     @relation(fields: [userId], references: [id])
  links        Barber[]
  reviews      Review[]
  images       Image[]
  bookings     Booking[]
  specialties  BarberProfileSpecialty[]
  applications JobApplication[]
  videos       Video[]

  @@index([availableForWork])
  @@map("barber_profiles")
}

model BarberProfileSpecialty {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  styleId   String   @map("style_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile BarberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  style   ServiceStyle  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([profileId, styleId])
  @@index([styleId])
  @@map("barber_profile_specialties")
}

enum ConversationKind {
  /// Cliente y barbería (consultas).
  CLIENT
  /// Barbería y barbero (invitaciones, postulaciones, trabajo).
  PROFESSIONAL
}

enum MessageSide {
  BARBERSHOP
  USER
  /// Mensaje automático de Charles (por ejemplo, "postuló a tu oferta").
  SYSTEM
}

/// Correo interno: una conversación entre una barbería (sus OWNER y MANAGER) y una persona.
model Conversation {
  id               String           @id @default(uuid(7)) @db.Uuid
  barbershopId     String           @map("barbershop_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  kind             ConversationKind
  lastMessageAt    DateTime         @default(now()) @map("last_message_at") @db.Timestamptz(3)
  barbershopReadAt DateTime?        @map("barbershop_read_at") @db.Timestamptz(3)
  userReadAt       DateTime?        @map("user_read_at") @db.Timestamptz(3)
  /// Quién bloqueó la conversación (nadie puede escribir hasta que se desbloquee).
  blockedBy        MessageSide?     @map("blocked_by")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  user       User       @relation("ConversationUser", fields: [userId], references: [id])
  messages   Message[]

  @@unique([barbershopId, userId, kind])
  @@index([userId, lastMessageAt])
  @@index([barbershopId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  side           MessageSide
  senderId       String?     @map("sender_id") @db.Uuid
  /// Cuerpo cifrado (como los tickets de soporte).
  bodyEnc        String      @map("body_enc")
  /// Retirado por soporte tras un reporte: ya no se muestra.
  removedAt      DateTime?   @map("removed_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?           @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  reports      MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  SCAM
  OTHER
}

model MessageReport {
  id           String              @id @default(uuid(7)) @db.Uuid
  messageId    String              @map("message_id") @db.Uuid
  reporterId   String              @map("reporter_id") @db.Uuid
  reason       MessageReportReason
  details      String?
  resolvedAt   DateTime?           @map("resolved_at") @db.Timestamptz(3)
  resolvedById String?             @map("resolved_by") @db.Uuid
  resolution   String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User    @relation("MessageReporter", fields: [reporterId], references: [id])
  resolvedBy User?   @relation("MessageReportResolver", fields: [resolvedById], references: [id])

  @@unique([messageId, reporterId])
  @@index([resolvedAt])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("message_reports")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  WEEKENDS
  COMMISSION
  FREELANCE
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

/// Bolsa de trabajo: oferta publicada por una barbería.
model JobPosting {
  id               String           @id @default(uuid(7)) @db.Uuid
  barbershopId     String           @map("barbershop_id") @db.Uuid
  title            String
  description      String
  employmentType   EmploymentType   @map("employment_type")
  compensationText String?          @map("compensation_text")
  /// Especialidades buscadas (ids de service_styles).
  styleIds         String[]         @map("style_ids") @db.Uuid
  status           JobPostingStatus @default(OPEN)
  closesAt         DateTime?        @map("closes_at") @db.Timestamptz(3)
  createdById      String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id])
  createdBy    User?            @relation("JobPostingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([barbershopId, status])
  @@index([status, createdAt])
  @@index([createdById])
  @@map("job_postings")
}

model JobApplication {
  id              String               @id @default(uuid(7)) @db.Uuid
  postingId       String               @map("posting_id") @db.Uuid
  barberProfileId String               @map("barber_profile_id") @db.Uuid
  message         String?
  status          JobApplicationStatus @default(APPLIED)
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  posting       JobPosting    @relation(fields: [postingId], references: [id])
  barberProfile BarberProfile @relation(fields: [barberProfileId], references: [id])

  @@unique([postingId, barberProfileId])
  @@index([barberProfileId])
  @@map("job_applications")
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

/// Videos de 30 s: publicidad del local (barbería) o cortes del barbero (perfil).
model Video {
  id              String      @id @default(uuid(7)) @db.Uuid
  barbershopId    String?     @map("barbershop_id") @db.Uuid
  barberProfileId String?     @map("barber_profile_id") @db.Uuid
  uploadedById    String      @map("uploaded_by") @db.Uuid
  status          VideoStatus @default(PROCESSING)
  caption         String?
  /// Claves en el almacenamiento: { video, poster } y, mientras se procesa, { original }.
  variants        Json        @default("{}")
  durationMs      Int?        @map("duration_ms")
  failureReason   String?     @map("failure_reason")
  /// Retirado por soporte (moderación).
  removedAt       DateTime?   @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  barbershop    Barbershop?    @relation(fields: [barbershopId], references: [id])
  barberProfile BarberProfile? @relation(fields: [barberProfileId], references: [id])
  uploadedBy    User           @relation("VideoUploader", fields: [uploadedById], references: [id])
  reports       VideoReport[]

  @@index([barbershopId, createdAt])
  @@index([barberProfileId, createdAt])
  @@index([uploadedById])
  @@map("videos")
}

model VideoReport {
  id         String            @id @default(uuid(7)) @db.Uuid
  videoId    String            @map("video_id") @db.Uuid
  reporterId String            @map("reporter_id") @db.Uuid
  reason     ImageReportReason
  details    String?
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, reporterId])
  @@index([resolvedAt])
  @@map("video_reports")
}

// ───────────── Recomendación por forma de cara (Etapa 1) ─────────────

enum FaceShape {
  OVAL
  ROUND
  SQUARE
  OBLONG
  HEART
  DIAMOND
}

enum MaintenanceLevel {
  LOW
  MEDIUM
  HIGH
}

enum HairType {
  STRAIGHT
  WAVY
  CURLY
  COILY
}

enum StyleVibe {
  CLASSIC
  MODERN
}

/// Compatibilidad entre una forma de cara y un corte (0 a 100). Empieza con criterios generales de
/// barbería (`validated = false`) y la ajusta un ADMIN con evidencia.
model FaceShapeRule {
  id        String    @id @default(uuid(7)) @db.Uuid
  faceShape FaceShape @map("face_shape")
  styleId   String    @map("style_id") @db.Uuid
  score     Int       @db.SmallInt
  note      String?
  validated Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  style ServiceStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([faceShape, styleId])
  @@index([styleId])
  @@map("face_shape_rules")
}
