enum FaceShape {
  OVAL
  ROUND
  SQUARE
  OBLONG
  HEART
  DIAMOND
}

enum MaintenanceLevel {
  LOW
  MEDIUM
  HIGH
}

enum HairType {
  STRAIGHT
  WAVY
  CURLY
  COILY
}

enum StyleVibe {
  CLASSIC
  MODERN
}

