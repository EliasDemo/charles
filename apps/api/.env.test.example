# Copia este archivo a .env.test para ejecutar `pnpm test:e2e` en local.
# Base de datos y Redis exclusivos de pruebas (las e2e borran datos).
DATABASE_URL=postgresql://charles:charles_local_only@127.0.0.1:5432/charles_test?schema=public
REDIS_URL=redis://127.0.0.1:6379/1
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=loopback
SWAGGER_ENABLED=false
LOG_LEVEL=silent
BODY_LIMIT=100kb
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
# Las claves de cifrado de las pruebas se generan aleatoriamente en cada ejecución
# (test/support/load-test-env.ts); no hace falta definirlas aquí.
