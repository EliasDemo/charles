  "info": {
    "title": "Charles API",
    "description": "API de reservas para barberías. Todos los endpoints están bajo /api/v1.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComponentStatus"
              }
            ]
          },
          "redis": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComponentStatus"
              }
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR",
            "description": "Código estable, en inglés."
          },
          "message": {
            "type": "string",
            "example": "Los datos enviados no son válidos.",
            "description": "Mensaje en español."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "requestId": {
            "type": "string",
            "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "CLIENT",
          "BARBER",
          "OWNER",
          "SUPPORT"
        ]
      },
      "NotificationChannel": {
        "type": "string",
        "enum": [
          "PUSH",
          "EMAIL",
          "IN_APP"
        ]
      },
      "NotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "notificationChannels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationChannel"
            }
          }
        },
        "required": [
          "notificationChannels"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "preferences": {
            "$ref": "#/components/schemas/NotificationPreferencesDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "emailVerified",
          "phone",
          "roles",
          "preferences",
          "createdAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Ana Pérez"
          },
          "phone": {
            "type": "object",
            "example": "+51 987 654 321",
            "nullable": true,
            "description": "null lo elimina"
          },
          "preferences": {
            "$ref": "#/components/schemas/NotificationPreferencesDto"
          }
        }
      },
      "TermsDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "2026-10"
          }
        },
        "required": [
          "version"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Ana Pérez"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "phone": {
            "type": "string",
            "example": "+51 987 654 321"
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Debe ser true: acepta los términos y condiciones."
          },
          "declaresAdult": {
            "type": "boolean",
            "description": "Debe ser true: declara tener 18 años o más (ADR 0003)."
          },
          "termsVersion": {
            "type": "string",
            "description": "Versión de los términos que el usuario aceptó (GET /auth/terms)."
          }
        },
        "required": [
          "fullName",
          "email",
          "password",
          "acceptTerms",
          "declaresAdult",
          "termsVersion"
        ]
      },
      "AcceptedResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "example": "iPhone de Ana",
            "description": "Nombre del dispositivo."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "fullName",
          "roles",
          "emailVerified"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserDto"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "allDevices": {
            "type": "boolean",
            "description": "true cierra la sesión en todos los dispositivos."
          }
        }
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "EmailVerificationConfirmDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
