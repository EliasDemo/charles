{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Estado del servicio y sus dependencias",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Charles API",
    "description": "API de reservas para barberías. Todos los endpoints están bajo /api/v1.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComponentStatus"
              }
            ]
          },
          "redis": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComponentStatus"
              }
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR",
            "description": "Código estable, en inglés."
          },
          "message": {
            "type": "string",
            "example": "Los datos enviados no son válidos.",
            "description": "Mensaje en español."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "requestId": {
            "type": "string",
            "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ]
      }
    }
  }
}
